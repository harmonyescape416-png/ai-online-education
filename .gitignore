# ---- Java / Maven 构建产物 ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ---- Node / 前端 ----
node_modules/
kzai-frontend/dist/
*.local

# ---- 运行日志（运行时产物，非代码） ----
logs/
.runtime/
*.log

# ---- IDE / 系统 ----
.idea/
*.iml
.vscode/
.DS_Store

# ---- 个人工具记忆（不进入交付包，不删除本机内容） ----
.workbuddy/

# ---- 前端工具缓存 ----
**/.vite/

# ---- 临时文件 ----
*.tmp
*.bak
*.orig
*.rej

# ---- 本地环境与 Python 缓存 ----
.env
.env.*
!.env.example
__pycache__/
*.py[cod]

# ---- 本地业务上传与测试运行数据 ----
/data/
/test-results/
