# ---- Java / Maven 构建产物 ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ---- Node / 前端 ----
node_modules/
kzai-frontend/dist/
*.local

# ---- 运行日志（运行时产物，非代码） ----
logs/
.runtime/
*.log

# ---- IDE / 系统 ----
.idea/
*.iml
.vscode/
.DS_Store

# ---- 个人工具记忆（不进入交付包，不删除本机内容） ----
.workbuddy/

# ---- 前端工具缓存与测试产物 ----
**/.vite/
kzai-frontend/coverage/
kzai-frontend/.npm-cache/
kzai-frontend/tests/.artifacts/

# ---- 临时文件 ----
*.tmp
*.bak
*.orig
*.rej

# ---- 本地环境与 Python 缓存 ----
.env
.env.*
!.env.example
__pycache__/
*.py[cod]

# ---- 本地业务上传与测试运行数据 ----
/data/
/test-results/

# 演示数据清理备份（含测试数据，不进入交付包）
deploy/demo-seed/backup-*/

# ---- 个人材料与答辩产物，不进入公开仓库 ----
*.docx
*.doc
*.pptx
*.xlsx
/outputs/
/doc_final/
/主题方案_*/
/用例图/
/实习报告_图片/
/实习笔记_截图/
/slide-outline.md
/语音交互演示.gif
