# ---- M15 部署环境变量示例（复制为 .env 后按需修改）----
# 端口
GATEWAY_PORT=18080
WEB_PORT=8080

# MySQL（生产必须改强密码）
MYSQL_ROOT_PASSWORD=kzai-root-2026
MYSQL_PASSWORD=Kzai@2026

# Redis（生产必须改强密码）
REDIS_PASSWORD=kzai-redis-2026

# JWT / 内部签名密钥（生产必须更换，不得使用默认值）
KZAI_JWT_SECRET=local-dev-jwt-secret-please-change-in-production
KZAI_INTERNAL_SECRET=local-dev-internal-secret-please-change

# Nacos 鉴权（生产必须 true 并配置用户名/密码；本地演示可 false）
NACOS_AUTH_ENABLE=false

# 真实 AI（默认关闭=MOCK；开启必须提供有效 Key；语音/文本/向量分别计费）
DASHSCOPE_ENABLED=false
DASHSCOPE_API_KEY=
EMBEDDING_PROVIDER=mock
